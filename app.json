{
  "expo": {
    "name": "திருக்குறள் - Thirukkural",
    "slug": "thirukkural",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thirukkural",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nltsravi.kurals",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app accesses your photos to select custom background image for sharing cards."
      }
    },
    "android": {
      "package": "com.nltsravi.kurals",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#EA7A00",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "allowBackup": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EA7A00"
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF7C0A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app accesses your photos to select custom background image for sharing cards.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "afdea11a-c55d-45ca-84f2-2ec33747d229"
      },
      "buildNumber": "789153014202610011.1.0"
    }
  }
}
