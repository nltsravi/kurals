{
  "expo": {
    "name": "திருக்குறள் - Thirukkural",
    "slug": "thirukkural",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "thirukkural",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nltsravi.kurals",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app accesses your photos to select custom background image for sharing cards.",
        "NSMicrophoneUsageDescription": "This app uses the microphone to assess your Tamil pronunciation when learning Thirukkural."
      }
    },
    "android": {
      "package": "com.nltsravi.kurals",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#EA7A00",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA"
      ],
      "allowBackup": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EA7A00"
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF7C0A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app accesses your photos to select custom background image for sharing cards.",
          "cameraPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "This app uses the microphone to assess your Tamil pronunciation when learning Thirukkural.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "This app uses the microphone to listen to your Thirukkural recitation in Tamil.",
          "speechRecognitionPermission": "This app converts your Tamil Thirukkural recitation into text to compare it with the original Kural.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-dontwarn com.facebook.react.**\n-keep public class * implements com.bumptech.glide.module.GlideModule\n-keep class * extends com.bumptech.glide.module.AppGlideModule { <init>(...); }\n-dontwarn com.bumptech.glide.**"
          }
        }
      ],
      "./plugins/withAndroidOptimizations"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "afdea11a-c55d-45ca-84f2-2ec33747d229"
      },
      "buildNumber": "789153014202610011.1.0"
    }
  }
}
